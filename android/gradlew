#!/usr/bin/env sh

APP_HOME=$(cd "$(dirname "$0")" && pwd -P)
GRADLE_USER_HOME=${GRADLE_USER_HOME:-"$HOME/.gradle"}
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  mkdir -p "$APP_HOME/gradle/wrapper" "$GRADLE_USER_HOME/wrapper/dists"
  echo "Gradle wrapper JAR is not checked into this repository." >&2
  echo "Install Gradle locally and run 'gradle wrapper --gradle-version 8.9', or copy a verified gradle-wrapper.jar into gradle/wrapper/." >&2
  exit 1
fi

exec java -jar "$WRAPPER_JAR" "$@"
